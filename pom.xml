<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>ge.automation</groupId>
    <artifactId>wikipedia-final-project</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>Wikipedia Automation Final Project</name>
    <description>Selenium (POM + PageFactory) + TestNG + RestAssured final project</description>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <selenium.version>4.46.0</selenium.version>
        <webdrivermanager.version>6.3.4</webdrivermanager.version>
        <testng.version>7.12.0</testng.version>
        <restassured.version>5.5.7</restassured.version>

        <surefire.version>3.5.6</surefire.version>
        <compiler.plugin.version>3.14.1</compiler.plugin.version>
    </properties>

    <dependencies>

        <!-- Selenium: ბრაუზერის მართვა, ელემენტების პოვნა, PageFactory -->
        <dependency>
            <groupId>org.seleniumhq.selenium</groupId>
            <artifactId>selenium-java</artifactId>
            <version>${selenium.version}</version>
        </dependency>

        <!-- WebDriverManager: chromedriver-ს ავტომატურად ჩამოტვირთავს.
             ამიტომ პროექტი ნებისმიერ კომპიუტერზე გაეშვება (დავალების 1-ლი პუნქტი). -->
        <dependency>
            <groupId>io.github.bonigarcia</groupId>
            <artifactId>webdrivermanager</artifactId>
            <version>${webdrivermanager.version}</version>
        </dependency>

        <!-- TestNG: ტესტების ანოტაციები, Assert / SoftAssert, ჯგუფები (7-ე პუნქტი) -->
        <dependency>
            <groupId>org.testng</groupId>
            <artifactId>testng</artifactId>
            <version>${testng.version}</version>
        </dependency>

        <!-- RestAssured: API ტესტები (8-ე პუნქტი) -->
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <version>${restassured.version}</version>
        </dependency>

        <!-- RestAssured-ის JSON პასუხების შესამოწმებლად (matchesJsonSchema, hasItems და ა.შ.) -->
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>json-path</artifactId>
            <version>${restassured.version}</version>
        </dependency>

    </dependencies>

    <build>
        <plugins>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${compiler.plugin.version}</version>
            </plugin>

            <!-- Surefire: ის უშვებს ტესტებს "mvn test"-ზე.
                 suiteXmlFiles ეუბნება, რომ testng.xml-ის მიხედვით იმუშაოს. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire.version}</version>
                <configuration>
                    <suiteXmlFiles>
                        <suiteXmlFile>testng.xml</suiteXmlFile>
                    </suiteXmlFiles>
                    <!-- ტესტი რომ ჩავარდეს, build არ შეწყდეს — რეპორტი მაინც დაგენერირდეს -->
                    <testFailureIgnore>false</testFailureIgnore>
                    <!-- SSL-ის პარამეტრი — იხ. <profiles> ბლოკი ქვემოთ -->
                    <argLine>${surefire.argLine}</argLine>
                </configuration>
            </plugin>

        </plugins>
    </build>

    <!--
      ================================================================
       SSL სერტიფიკატების პრობლემის გადაწყვეტა
      ================================================================
      ზოგიერთ ქსელში (ოფისი, უნივერსიტეტი, ანტივირუსი) დგას მოწყობილობა,
      რომელიც HTTPS ტრაფიკს ამოწმებს და თავისი სერტიფიკატით ხელს აწერს.
      Windows ასეთ სერტიფიკატს ენდობა, მაგრამ Java-ს თავისი ცალკე საცავი
      აქვს (cacerts), სადაც ის არ არის — ამიტომ API ტესტები ჩავარდება
      შეცდომით "PKIX path building failed".

      გამოსავალი: Windows-ზე Java-ს ვეუბნებით, რომ Windows-ის სერტიფიკატების
      საცავი გამოიყენოს. ეს უსაფრთხოებას არ თიშავს — Java ზუსტად იმას
      ენდობა, რასაც სისტემა.

      Linux / macOS-ზე ეს პარამეტრი არ არსებობს, ამიტომ იქ ცარიელი რჩება.
      ასე პროექტი ყველა ოპერაციულ სისტემაზე მუშაობს (დავალების 1-ლი პუნქტი).
    -->
    <profiles>

        <profile>
            <id>windows-truststore</id>
            <activation>
                <os><family>windows</family></os>
            </activation>
            <properties>
                <surefire.argLine>-Djavax.net.ssl.trustStoreType=WINDOWS-ROOT</surefire.argLine>
            </properties>
        </profile>

        <profile>
            <id>default-truststore</id>
            <activation>
                <os><family>!windows</family></os>
            </activation>
            <properties>
                <surefire.argLine>-Dfile.encoding=UTF-8</surefire.argLine>
            </properties>
        </profile>

    </profiles>

</project>
