<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
  testng.xml — ეს ფაილი განსაზღვრავს, რომელი ტესტები გაეშვას და როგორ.
  Maven-ის surefire პლაგინი ამ ფაილს კითხულობს (იხ. pom.xml).

  გაშვება:
    mvn clean test                    -> ყველა ტესტი
    mvn clean test -Dgroups=smoke     -> მხოლოდ smoke ჯგუფი
-->
<suite name="Wikipedia Final Project Suite" verbose="1">

    <!--
      Listener — ჩვენი კლასი, რომელიც ლოგავს შედეგებს
      და ჩავარდნისას სქრინშოტს იღებს.
    -->
    <listeners>
        <listener class-name="ge.automation.listeners.TestListener"/>
    </listeners>

    <!-- ================================================== -->
    <!--  1. API ტესტები — სწრაფია, ბრაუზერს არ საჭიროებს   -->
    <!--     ამიტომ ჯერ ისინი გავუშვათ                       -->
    <!-- ================================================== -->
    <test name="API Tests (RestAssured)" preserve-order="true">
        <classes>
            <class name="ge.automation.tests.api.BookingApiTest"/>
        </classes>
    </test>

    <!-- ================================================== -->
    <!--  2. ვებ ტესტები — Selenium, ბრაუზერით               -->
    <!-- ================================================== -->
    <test name="Web Tests (Selenium POM)" preserve-order="true">
        <classes>
            <class name="ge.automation.tests.web.SearchTest"/>
            <class name="ge.automation.tests.web.LanguageDropdownTest"/>
            <class name="ge.automation.tests.web.AdvancedSearchTest"/>
            <class name="ge.automation.tests.web.LoginTest"/>
            <class name="ge.automation.tests.web.RegistrationTest"/>
        </classes>
    </test>

</suite>
